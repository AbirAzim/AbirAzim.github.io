# Environment variables (Vercel + local `vercel dev` only)
# Browsers cannot read .env — the key is used only on the server in /api/chat.js

# Required for live AI on Vercel: add the same name in Vercel → Project → Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI is not wired to /api yet; use Gemini for this portfolio.

# Local testing with API routes:
#   npx vercel link   (once)
#   npx vercel env pull .env.local   (optional: pull keys from Vercel)
#   npx vercel dev
# Then open the URL vercel prints (not plain python http.server).
