# Server-only env (Vercel Dashboard + local `vercel dev`). Never commit real keys.

# Google Gemini (optional if you use OpenAI instead)
GEMINI_API_KEY=

# OpenAI — used if set; also auto-fallback when Gemini fails (quota, etc.)
OPENAI_API_KEY=

# Optional: gemini | openai | auto (default auto: try Gemini first, then OpenAI)
# CHAT_PROVIDER=auto

# Optional models
# GEMINI_MODEL=gemini-1.5-flash-8b
# OPENAI_MODEL=gpt-4o-mini

# Local: npx vercel link && npm run dev:vercel
